{
  "name": "businessautomate-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "audit": "tsx src/scripts/generate-audit.ts",
    "payment:simulate": "tsx src/scripts/simulate-payment.ts",
    "email:preview": "tsx src/scripts/preview-emails.ts",
    "email:follow-ups": "tsx src/scripts/send-follow-ups.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:reset": "docker compose down -v && npm run db:up && npm run prisma:deploy",
    "setup": "npm run db:up && npm run prisma:deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "6.2.1",
    "fastify": "^5.2.1",
    "pino": "^10.3.1",
    "prisma": "6.2.1",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
