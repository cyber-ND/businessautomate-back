# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API.
WEB_ORIGIN=http://localhost:5173,https://brainycyber.com,https://www.brainycyber.com

# Postgres. Railway provides this for its managed instance; for local work,
# either point at a local Postgres or use a Railway dev database directly.
DATABASE_URL=postgresql://user:password@localhost:5432/businessautomate

# --- AI engine ---
ANTHROPIC_API_KEY=sk-ant-...
# Free audits are marketing and run cheap; paid audits run on the best model.
AI_MODEL_FREE=claude-sonnet-5
AI_MODEL_PAID=claude-opus-5
AI_MODEL_TRIAGE=claude-sonnet-5

# Effort moves cost, latency and depth more than the model choice does.
# See the measurements table in README.md before changing these.
AI_EFFORT_FREE=medium
AI_EFFORT_PAID=high

# Which tier's model writes the audit. It is generated once and gating is
# display-only, so this decides what BOTH free and paying viewers read.
AI_GENERATION_TIER=PAID

# --- Frontend ---
# Paystack redirects here after payment; emailed report links point here too.
WEB_APP_URL=http://localhost:5173

# --- Payments (Paystack) ---
# Optional in development, required in production. Dashboard > Settings > API
# Keys & Webhooks. Use the sk_test_ key until the business is verified.
PAYSTACK_SECRET_KEY=sk_test_...

# Currencies your Paystack account can actually charge, most preferred first.
# An audit is only ever denominated in a currency listed here, so we never
# generate a report we cannot sell. A Nigeria-registered business has NGN by
# default; USD additionally requires international payments (compliance) and a
# Zenith Bank USD domiciliary account for payouts. GHS/KES/ZAR are for businesses
# registered in those countries.
PAYSTACK_CURRENCIES=NGN

# Prices in MINOR units: kobo for NGN, cents for USD.
REPORT_PRICE_NGN_MINOR=2500000
REPORT_PRICE_USD_MINOR=4900
